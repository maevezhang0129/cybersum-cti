# Secrets — never commit
.env
.env.*
!.env.example
local.settings.json
appsettings.json

# Ad-hoc evaluation runs. published/ is the thesis archive and runs/2026-08-12
# is the current reference result; both are committed. Everything else is
# someone's local experiment.
evaluation/outputs/runs/*
!evaluation/outputs/runs/2026-08-12/

