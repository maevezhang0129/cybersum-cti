# Copy to .env and fill in. Nothing here is required for `make demo`, which runs
# offline against a recorded LLM response and a local throwaway database.

# ── LLM ───────────────────────────────────────────────────────────────────────
# azure  — Azure OpenAI (how the system ran in deployment)
# openai — OpenAI API directly (how the evaluation harness ran)
# replay — no network; replays a recorded response from fixtures/cassettes/
# Leave unset: resolves to "openai" if OPENAI_API_KEY is set, else "replay".
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI only (LLM_PROVIDER=azure)
OPENAI_API_ENDPOINT=
OPENAI_DEPLOYMENT_NAME=
OPENAI_API_VERSION=2024-02-15-preview

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
# DB_PORT=8087   # historical: the VNet-published port in the original deployment
DB_NAME=cybersum
DB_USER=cybersum
DB_PASS=cybersum

# ── Email delivery ────────────────────────────────────────────────────────────
# Off by default. `make demo` can never send mail.
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=25
SENDER_NAME=Cybersum
SENDER_EMAIL=cybersum@example.org
EMAIL_RECIPIENTS=            # comma-separated
EMAIL_ORG_PREFIX=Cybersum    # appears in the subject line
DEBUG_SMTP=false

# ── Ingestion collectors (optional; not needed for the demo or evaluation) ─────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONES=            # name=zoneid,name=zoneid
UPTIMEROBOT_API_TOKEN=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WEBAPP_NAME=

# ── Behaviour flags ───────────────────────────────────────────────────────────
USE_MOCK_DATA=false          # read fixtures/aggregated_context.json, skip DB write + email
DEBUG=false
